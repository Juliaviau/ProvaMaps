<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="@android:color/white">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Afegir font"
                android:textColor="#1D1B20"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"/>
            <Button
                android:id="@+id/boto_tancar_afegir_font"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel·lar" />
        </LinearLayout>










        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:text="Imatge de la font"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/penja_imatge_font_desc"
                    android:layout_marginHorizontal="2dp"
                    android:textStyle="italic"
                    android:textSize="14sp"
                    android:layout_weight="1"/>

                <ImageView
                    android:id="@+id/iv_imatgeAfegirFont"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:layout_marginVertical="12dp"
                    android:background="#E0E0E0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="5dp"
                        style="?attr/materialButtonOutlinedStyle"
                        android:id="@+id/boto_afegirImatgeFont"
                        android:paddingHorizontal="2dp"
                        android:drawableTint="@color/color_font"
                        android:drawableBottom="@drawable/icona_galeria"  />
                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:paddingHorizontal="2dp"
                        android:layout_marginTop="5dp"
                        android:drawableBottom="@drawable/icona_fer_foto"
                        android:id="@+id/boto_ferFotoFont"
                        android:drawableTint="@color/color_font"
                        style="?attr/materialButtonOutlinedStyle" />
                    <Button
                        android:id="@+id/boto_afegirImatgeFont"
                        android:text="Galeria"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_marginEnd="8dp"/>
                    <Button
                        android:id="@+id/boto_ferFotoFont"
                        android:text="Càmera"
                        style="?attr/materialButtonOutlinedStyle"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>











        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:text="Característiques" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                <TextView android:text="Potable?" android:layout_marginTop="12dp" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/tggb_fontPotable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">
                    <Button style="?attr/materialButtonOutlinedStyle" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Potable" />
                    <Button style="?attr/materialButtonOutlinedStyle" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:text="No" />
                    <Button style="?attr/materialButtonOutlinedStyle"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Sense informació" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="250dp">
                <ImageView
                    android:id="@+id/iv_mapaPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/mapafont" />
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_centerInParent="true"
                    android:src="@android:drawable/ic_menu_mylocation"
                    app:tint="#D32F2F" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/boto_afegir_afegirFont"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:text="Guardar Font"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>