<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/lay_principal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:fitsSystemWindows="true">
            <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            app:elevation="0dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar_afegir"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:textColor="@color/black"
                        android:id="@+id/tv_TitolAfegirFont"
                        android:layout_marginStart="12dp"
                        android:text="@string/afegir_font"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        />

                    <ImageButton
                        android:id="@+id/boto_tancar_afegir_font"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/icona_tancar"
                        app:tint="@color/black"
                        android:contentDescription="Tancar" />
                </RelativeLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Imatge de la font"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/penja_imatge_font_desc"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:textStyle="italic"
                    android:lineSpacingExtra="2sp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginVertical="16dp"
                    app:cardBackgroundColor="#F2F2F2"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:id="@+id/iv_imatgeAfegirFont"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="40dp"
                        android:src="@drawable/icona_imatge" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/boto_afegirImatgeFont"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        app:icon="@drawable/icona_galeria"
                        app:iconGravity="textStart"
                        app:cornerRadius="20dp"
                        android:drawableTint="#302D2D"
                        android:textColor="#616161"
                        android:text="Galeria"
                        android:textAllCaps="false"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/boto_ferFotoFont"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:icon="@drawable/icona_fer_foto"
                        app:iconGravity="textStart"
                        app:cornerRadius="20dp"
                        android:drawableTint="#302D2D"
                        android:textColor="#616161"
                        android:text="Càmera"
                        android:textAllCaps="false"/>
                </LinearLayout>
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>



        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#C5C5C5"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:text="Configuració de la font"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:textSize="20sp"
                    android:layout_marginBottom="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Qualitat de l'aigua"
                    android:textStyle="bold"
                    android:textColor="#555555"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/tggb_fontPotable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">
                    <Button
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Potable"
                        android:tag="P"
                        style="?attr/materialButtonOutlinedStyle"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:paddingHorizontal="2dp"
                        android:textSize="12sp"
                        android:id="@+id/btn_potable_si"
                        android:textAllCaps="false"
                        app:strokeColor="#D1D1D1"
                        app:backgroundTint="@color/selector_estat"/>
                    <Button
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="No potable"
                        android:tag="NP"
                        style="?attr/materialButtonOutlinedStyle"
                        android:id="@+id/btn_potable_no"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:paddingHorizontal="2dp"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        app:strokeColor="#D1D1D1"
                        app:backgroundTint="@color/selector_estat"/>
                    <Button
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Desconeguda"
                        android:tag="D"
                        style="?attr/materialButtonOutlinedStyle"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:paddingHorizontal="2dp"
                        android:id="@+id/btn_potable_desconeguda"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        app:strokeColor="#D1D1D1"
                        app:backgroundTint="@color/selector_estat"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:text="Estat del servei"
                    android:textStyle="bold"
                    android:textColor="#555555"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/tggb_fontEstat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">
                    <Button android:id="@+id/boto_tggb_fontServei"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="En servei"
                        android:tag="ES"
                        android:textAllCaps="false"
                        app:strokeColor="#D1D1D1"
                        app:backgroundTint="@color/selector_estat"/>
                    <Button android:id="@+id/boto_tggb_fontNoServei"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Sense servei"
                        android:tag="SS"
                        android:textAllCaps="false"
                        app:strokeColor="#D1D1D1"
                        app:backgroundTint="@color/selector_estat"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_margin="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <org.osmdroid.views.MapView
                    android:id="@+id/mapa_afegir_font"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_centerInParent="true"
                    android:paddingBottom="22dp"
                    android:src="@drawable/icona_font"
                    android:translationY="-11dp" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="italic"
            android:textAlignment="center"
            android:layout_gravity="center"
            android:paddingHorizontal="15sp"
            android:text="@string/adrecanodisponible"
            android:id="@+id/textAdrecaFont"/>

        <Button
            android:id="@+id/boto_afegir_afegirFont"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/color_font"
            android:text="Guardar Font"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:layout_marginHorizontal="50dp"
            app:cornerRadius="16dp"/>

    </LinearLayout>
</ScrollView>




    <!--?xml version="1.0" encoding="utf-8"?>

